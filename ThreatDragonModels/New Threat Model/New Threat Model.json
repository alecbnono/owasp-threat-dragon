            "data": {
              "type": "tm.Actor",
              "name": "Browser Client",
              "description": "End user's browser (external entity)",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "dc214134-8d38-4c51-b5dd-5ccb7380e03a",
                  "title": "Credential theft or session hijacking",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker who obtains a user's credentials or session cookie can impersonate that user.",
                  "mitigation": "MFA at the identity provider; HttpOnly, Secure and SameSite cookies; short session lifetime.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "5b81cf50-dfb3-45c5-bd64-530ba9118e41",
                  "title": "User denies submitting feedback",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Repudiation",
                  "description": "Without a trustworthy record, a user can deny having submitted a comment.",
                  "mitigation": "Write audit events (flow 11) with user ID, timestamp and source IP.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                }
              ],
              "providesAuthentication": false
            }
          },
