              "threats": [
                {
                  "id": "c6c00029-66cf-4da7-9a87-f204ddad07f7",
                  "title": "Forged or replayed authentication tokens",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Weakly validated or unsigned tokens can be forged or replayed to impersonate users.",
                  "mitigation": "Sign tokens; validate issuer, audience, expiry and nonce; use TLS.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                },
                {
                  "id": "fb575623-4c0f-4110-8836-8a99340c43d5",
                  "title": "Role or claim manipulation",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Tampering with roles or claims in a token grants higher privileges than assigned.",
                  "mitigation": "Signed tokens; look up roles server-side; apply least privilege.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": ""
                }
              ],
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
