            "data": {
              "type": "tm.Process",
              "name": "Web Application",
              "description": "Handles login, session and feedback submission",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "376a6e14-2a77-4ce5-9898-58c360e5d7bc",
                  "title": "Impersonation of the application or session fixation",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "A fake site or a fixed session ID lets an attacker pose as the application or the user.",
                  "mitigation": "TLS with a valid certificate, HSTS, regenerate the session ID on login.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "36ad06d6-3ea8-49c5-9fe5-635fb0bc2a59",
                  "title": "SQL injection through the feedback comment",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Unsanitised comment text concatenated into the INSERT query allows data tampering.",
                  "mitigation": "Parameterised queries or an ORM; input validation; output encoding.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "8ed722cc-f422-44d3-b390-1e7519c1195a",
                  "title": "Broken access control",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Missing or client-side authorisation checks let a user perform actions beyond their role.",
                  "mitigation": "Enforce authorisation server-side on every request; validate token claims; least privilege.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "0c0d63ef-c4f0-422f-8534-7b627217357f",
                  "title": "Verbose errors leak internals",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information disclosure",
                  "description": "Stack traces or DB errors returned to the client reveal schema and configuration.",
                  "mitigation": "Generic error pages; log details server-side only.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "e214df28-3dd2-4f54-84b9-71a4a4c49522",
                  "title": "Request flooding",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Automated floods of login or feedback requests exhaust the application or database.",
                  "mitigation": "Rate limiting, WAF, timeouts and connection limits.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                }
              ],
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": ""
            }
